# Env used by `dbt parse` in CI. No warehouse connection is made.
#
# The NON-SECRET values must equal production. dbt hashes the connection
# info (host, port, user, dbname, schema, ...) and any env_var() a project
# reads into the parse state of partial_parse.msgpack. If these differ at
# runtime, dbt throws the shipped msgpack away and re-parses every task.
#
# Secrets use the DBT_ENV_SECRET_ prefix, which dbt leaves out of that hash,
# so a dummy value here is fine.
DBT_PG_HOST=warehouse.prod.internal
DBT_PG_PORT=5432
DBT_PG_USER=airflow_dbt
DBT_PG_DBNAME=analytics
DBT_ENV_SECRET_PG_PASSWORD=not-a-real-password
