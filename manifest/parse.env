# Env used by `dbt parse` in CI (dbt_bundle.yml: parse_env). No warehouse
# connection is made, and the connection itself comes from profiles/profiles.yml.
#
# Put values here only for env_var() calls in the projects (dbt_project.yml,
# models, macros) that have no default. KEY=value, one per line. Never commit
# real secrets: dummy values are fine for parsing.
