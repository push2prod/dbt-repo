# Parse env for the strain test's local warehouse (see ci/parse.env for the rules).
# The secret is deliberately different from the runtime one ("strain"), to
# show that DBT_ENV_SECRET_* values don't invalidate partial_parse.msgpack.
DBT_PG_HOST=127.0.0.1
DBT_PG_PORT=54329
DBT_PG_USER=airflow_dbt
DBT_PG_DBNAME=analytics
DBT_ENV_SECRET_PG_PASSWORD=dummy-at-parse-time
